# 复制成 .env 后填写，再 `set -a; source .env; set +a`
# ---- 必填（只有重新配音 / 跑豆包实测才需要；仓库已附第28期配音，可先不填）----
DOUBAO_SPEECH_KEY=        # 火山引擎「豆包语音合成 2.0」API Key（音色 zh_male_liufei_uranus_bigtts）
ARK_API_KEY=              # 火山方舟 API Key（tools/doubao_qa.py 实测模型回答用）
# ---- 外部程序（不填就用 PATH 里的）----
FFMPEG=ffmpeg
FFPROBE=ffprobe
CHROME=/usr/bin/google-chrome
YTDLP=yt-dlp
PYTHON=python3
# ---- 可选 ----
WHISPER_MODEL=small       # faster-whisper 模型名或本地目录（逐字对时、字幕质检用）
CJK_FONT=/usr/share/fonts/google-noto-cjk/NotoSansCJK-Bold.ttc   # 缩略图标注用
YT_COOKIES=               # YouTube 拦机器人时用，cookies.txt 只导出 youtube/google 域
